# Working notes and the internal code this library was repurposed from.
concept.txt
results-helper.ts

# Dependencies
node_modules/
*/node_modules/

# javascript/dist is deliberately committed: jsDelivr serves the browser bundle
# straight out of the repository, so the built files have to be in it.

# .NET build output. Scoped to dotnet/, because javascript/bin holds the CLI
# entry point and is meant to be committed.
dotnet/**/bin/
dotnet/**/obj/
dotnet/**/TestResults/
*.user

# Python build output and caches.
__pycache__/
*.py[cod]
python/build/
python/dist/
python/.venv/
python/*.egg-info/
.pytest_cache/
.ruff_cache/

# PHP dependencies and caches. composer.lock is not committed: this is a
# library, and the lock file of a library binds nobody.
php/vendor/
php/composer.lock
php/.phpunit.cache/
.phpunit.result.cache

# Go build output, and the corpus `go test -fuzz` writes as it works. The module
# has no dependencies, so there is no go.sum and nothing vendored.
go/json-compress
go/json-compress.exe
go/**/testdata/fuzz/
go/**/*.test
go/coverage.out

# Editor and OS noise
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
npm-debug.log*
*.log
