<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <RootNamespace>TechStyle.JsonCompress</RootNamespace>
    <AssemblyName>TechStyle.JsonCompress</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>TechStyle.JsonCompress</PackageId>
    <Title>json-compress</Title>
    <Description>Lossless JSON compression that is still JSON. Hoists repeated object keys into a catalogue, packs arrays of objects into columnar tables, and de-duplicates repeated string values - typically 40-80% smaller, still valid JSON, and an exact round trip. No dependencies on .NET 8 and later.</Description>
    <PackageTags>json;compress;compression;decompress;minify;columnar;dictionary;deduplicate;payload;bandwidth;api;serialization;lossless</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile></PackageLicenseFile>
    <PackageReleaseNotes>First release. Implements version 1 of the json-compress wire format.</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!--
    System.Text.Json is in the shared framework from .NET 8 onwards, so those
    targets carry no dependencies at all. netstandard2.0 is here for .NET
    Framework and Unity, and is the only target that needs the package.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TechStyle.JsonCompress.Tests" />
  </ItemGroup>

</Project>
