<Project>

  <!--
    Shared metadata for every project in this directory.

    Version, authorship and repository details live here so a release is a
    one-line change, and so the library, the CLI and the benchmark never drift
    apart on the version they claim to be.
  -->

  <PropertyGroup>
    <VersionPrefix>1.0.3</VersionPrefix>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <NoWarn>$(NoWarn);NU1902;NU1903</NoWarn>

    <Authors>Ejaz Hussain Arain</Authors>
    <Company>Tech Style Ltd</Company>
    <Copyright>Copyright (c) Tech Style Ltd</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://tech-style.co/product-json-compress.html</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eharain/JSON-Compress</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
