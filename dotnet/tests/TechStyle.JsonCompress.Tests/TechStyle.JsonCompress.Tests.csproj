<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>TechStyle.JsonCompress.Tests</AssemblyName>
    <RootNamespace>TechStyle.JsonCompress.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CA1861;CA1707;xUnit1044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TechStyle.JsonCompress\TechStyle.JsonCompress.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    The conformance corpus is produced by the JavaScript implementation and
    checked in, so these tests prove the two agree without needing Node.
  -->
  <ItemGroup>
    <Content Include="fixtures\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
